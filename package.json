{
  "name": "lifeos",
  "private": true,
  "version": "0.0.0",
  "description": "占位：命令与依赖在第一步实现时再填（见 .lifeos/projects/lifeos/knowledge/architecture/directory-structure.md）",
  "dependencies": {
    "@earendil-works/pi-agent-core": "link:./pi/packages/agent",
    "@earendil-works/pi-ai": "link:./pi/packages/ai",
    "@earendil-works/pi-coding-agent": "link:./pi/packages/coding-agent",
    "@hono/node-server": "^1.19.1",
    "@memtensor/memos-local-plugin": "2.0.16-beta.1",
    "hono": "^4.9.7"
  },
  "scripts": {
    "home:install": "node --experimental-strip-types src/install.ts",
    "home:check": "node --experimental-strip-types src/check-home.ts",
    "dev": "node --experimental-strip-types --watch src/main.ts",
    "dev:web": "pnpm --dir frontend dev",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs && pnpm --dir frontend build",
    "start": "node dist/server.mjs",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "dev:all": "concurrently -k -n api,web -c blue,magenta \"pnpm dev\" \"pnpm dev:web\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p frontend/tsconfig.json --noEmit",
    "stop": "node scripts/stop.mjs",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "test:ui": "node frontend/test/ui-contract.mjs",
    "test:ui:update": "node frontend/test/ui-contract.mjs --update-baseline",
    "audit:ui": "node scripts/audit-ui.mjs",
    "verify": "pnpm typecheck && pnpm lint:tokens && pnpm test && pnpm test:ui && pnpm test:mobile && pnpm test:jump && pnpm test:pwa",
    "test:mobile": "node frontend/test/mobile-contract.mjs",
    "test:jump": "node frontend/test/jump-to-latest.mjs",
    "test:pwa": "node frontend/test/pwa-contract.mjs"
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "axe-core": "^4.14.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "sharp",
      "esbuild",
      "onnxruntime-node"
    ]
  }
}
